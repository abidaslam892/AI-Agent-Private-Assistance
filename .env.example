# ========================================================
# Private ChatGPT-Style RAG AI Platform Environment Config
# ========================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=rag_db
POSTGRES_PORT=5432

# Ollama Model Runtime
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# RAG Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=3
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=2048

# Authentication & Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-random-64-hex-chars

# Initial accounts, created on first start only if a password is set
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
USER_USERNAME=operator
USER_PASSWORD=change-me-user-password
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload Storage
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE_MB=50

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
